phpunit.xml
phpunit.xml.dist
.phpunit.result.cache
.vscode
.idea
node_modules
package.json
package-lock.json
Gruntfile.js
.grunt

# Distribution tooling itself
build_zip.ps1
build_zip.sh
.distignore

# Internal RSMAX tooling and the private signing key — must NEVER ship.
generate_license.php
license_private.key

# Internal docs and assistants
.claude
CLAUDE.md
*.md
