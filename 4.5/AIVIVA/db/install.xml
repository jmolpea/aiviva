<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/aiviva/db" VERSION="20261003" COMMENT="XMLDB file for mod_aiviva"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="aiviva" COMMENT="Main table for aiviva activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course aiviva activity belongs to"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="openai_model_pdf" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="gpt-6.1-sol" SEQUENCE="false"/>
        <FIELD NAME="openai_model_tribunal" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="gpt-6.1-sol" SEQUENCE="false"/>
        <FIELD NAME="openai_model_eval" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="gpt-6.1-sol" SEQUENCE="false"/>
        <FIELD NAME="max_attempts" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="2" SEQUENCE="false" COMMENT="0 = unlimited"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = no opening date"/>
        <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = no closing date"/>
        <FIELD NAME="step1_maxfilesize" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="20" SEQUENCE="false" COMMENT="Max PDF size in MB"/>
        <FIELD NAME="step1_description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="step1_descriptionformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="step1_prompt" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Prompt for PDF analysis"/>
        <FIELD NAME="step2_description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="step2_descriptionformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="step2_prompt" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Prompt for video analysis"/>
        <FIELD NAME="step2_duration" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="10" SEQUENCE="false" COMMENT="Minutes: 5, 10, 15 or 30"/>
        <FIELD NAME="step2_maxfilesize" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="500" SEQUENCE="false" COMMENT="Max video size in MB"/>
        <FIELD NAME="step3_duration" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="10" SEQUENCE="false" COMMENT="Tribunal session duration in minutes"/>
        <FIELD NAME="step3_prompt_eval" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Final evaluation prompt"/>
        <FIELD NAME="tribunal_member_1_name" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="Dr. Smith" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_1_role" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="Examiner" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_1_prompt" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_1_voice" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="onyx" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_1_avatar" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="3" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_1_avatar_custom" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_2_name" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="Prof. Johnson" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_2_role" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="Reviewer" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_2_prompt" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_2_voice" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="nova" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_2_avatar" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="2" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_2_avatar_custom" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_3_name" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="Dr. Williams" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_3_role" TYPE="char" LENGTH="255" NOTNULL="false" DEFAULT="Subject Expert" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_3_prompt" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_3_voice" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="echo" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_3_avatar" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="tribunal_member_3_avatar_custom" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grading_workflow" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="group_submission" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="groupingid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="notify_student" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="video_purge_days" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="15" SEQUENCE="false"/>
        <FIELD NAME="safety_max_tokens" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="4096" SEQUENCE="false"/>
        <FIELD NAME="safety_content_filter" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="safety_extra_prompt" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
        <FIELD NAME="weight_pdf" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="33" SEQUENCE="false" COMMENT="Percentage weight of the document in the final grade"/>
        <FIELD NAME="weight_video" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="33" SEQUENCE="false" COMMENT="Percentage weight of the presentation in the final grade"/>
        <FIELD NAME="weight_tribunal" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="34" SEQUENCE="false" COMMENT="Percentage weight of the tribunal in the final grade"/>
        <FIELD NAME="completionsubmit" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aiviva_submissions" COMMENT="Student submissions for aiviva activities">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aiviva" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to aiviva table"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft|step1|step2|step3|submitted|grading|graded"/>
        <FIELD NAME="attempt" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="gdpr_consent" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="gdpr_consent_time" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="pdf_fileid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="pdf_analysis" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="video_fileid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="-1 means purged"/>
        <FIELD NAME="video_transcript" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="video_analysis" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_transcript" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON with full conversation history"/>
        <FIELD NAME="tribunal_analysis" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tribunal_briefing" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="AI-generated examiner briefing synthesised from PDF and video at tribunal start"/>
        <FIELD NAME="tribunal_timestart" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="When the tribunal session started (server clock)"/>
        <FIELD NAME="ai_grade" TYPE="number" LENGTH="10" NOTNULL="false" DECIMALS="5" SEQUENCE="false" COMMENT="Grade proposed by the AI, kept when a teacher overrides final_grade"/>
        <FIELD NAME="final_grade" TYPE="number" LENGTH="10" NOTNULL="false" DECIMALS="5" SEQUENCE="false"/>
        <FIELD NAME="final_feedback" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="grade_breakdown" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON with per-step breakdown"/>
        <FIELD NAME="grader_userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="workflow_state" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false" COMMENT="inreview|readyforrelease|released"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timegraded" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aiviva" TYPE="foreign" FIELDS="aiviva" REFTABLE="aiviva" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aiviva_userid" UNIQUE="false" FIELDS="aiviva, userid"/>
        <INDEX NAME="aiviva_status" UNIQUE="false" FIELDS="aiviva, status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aiviva_tribunal_messages" COMMENT="Detailed log of each tribunal turn">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="submission_id" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to aiviva_submissions"/>
        <FIELD NAME="turn_number" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="speaker" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="tribunal_1|tribunal_2|tribunal_3|participant"/>
        <FIELD NAME="message_text" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="audio_fileid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="File id for participant audio response"/>
        <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="submission_id" TYPE="foreign" FIELDS="submission_id" REFTABLE="aiviva_submissions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="submission_turn" UNIQUE="false" FIELDS="submission_id, turn_number"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aiviva_overrides" COMMENT="Per-user or per-group overrides for aiviva activities">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="aiviva" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to aiviva table"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to user table (null for group overrides)"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="FK to groups table (null for user overrides)"/>
        <FIELD NAME="max_attempts" TYPE="int" LENGTH="4" NOTNULL="false" SEQUENCE="false" COMMENT="Override max attempts (null = use activity default)"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Override open timestamp (null = use activity default)"/>
        <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Override close timestamp (null = use activity default)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="aiviva" TYPE="foreign" FIELDS="aiviva" REFTABLE="aiviva" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="aiviva_userid" UNIQUE="false" FIELDS="aiviva, userid"/>
        <INDEX NAME="aiviva_groupid" UNIQUE="false" FIELDS="aiviva, groupid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
